//@version=6
indicator("筹码峰 (可见范围成交量分布)", shorttitle = "筹码峰VP", overlay = true, max_boxes_count = 500, max_lines_count = 10, max_labels_count = 10, max_bars_back = 5000)

// 复刻 TradingView 「Visible Range Volume Profile」：
// 统计当前屏幕可见K线的成交量按价格分布，左侧锚定，70% 价值区绿色、其余灰色，POC 虚线延伸
//
// ═══════════════════════════ 使用说明 ═══════════════════════════
// 【图上元素】
//   · 横向柱子：该价位累计成交量，越长 = 该价位换手越多 = 筹码越密集
//   · 绿色：70% 价值区 (从 POC 向两侧扩展到覆盖 70% 成交量)，灰色：价值区外
//   · 同一行深色段 = 上涨日 (收≥开) 成交量，浅色段 = 下跌日成交量
//   · 灰色虚线：POC，成交量最大的价位，向右延伸
//   · 可选 VAH / VAL：价值区上沿 / 下沿
//
// 【怎么用】
//   1. 统计区间 = 屏幕可见范围：缩放 / 拖动图表即切换区间。
//      想要固定区间，打开「改用固定起始日期」。
//   2. 用柱子长短找结构：
//      · 筹码区：长且连成片的柱子 (多空充分换手、价格停留久的区域)
//      · 筹码真空：两个筹码区之间柱子很短的价位，价格进入后常常走得快
//   3. 柱子挡住 K 线时调小「宽度」；想要更细的分布调大「价格行数」(≤240)。
//   4. 最多统计最近 5,000 根 K 线；范围更大时只算最近 5,000 根，图上会出现提示。
//      没有成交量数据的品种 (如部分指数) 不画分布，只显示提示。
//
// 【回测结论：别把筹码峰当成单独的支撑信号】
//   22 个美股 / ETF，2009–2026 日线，约 2,700 次"价格从上方回踩某价位"事件，
//   250 日筹码分布，60 日内先 +5% 记反弹、先收盘 -5% 记跌破：
//     · 回踩 POC 反弹率 ≈ 61%，筹码前 20% ≈ 60%，筹码真空 ≈ 62% —— 没有差别
//     · 换 120 / 500 日窗口、±3% 阈值，结论不变
//     · 真正有区别的是趋势：200 日均线之上回踩 ≈ 67–75% 反弹，之下 ≈ 53–58%
//     · 深色 (上涨日) 占比高低对反弹率也没有稳定影响
//   实战建议：
//     · 把 POC / 筹码区看成"磁铁"(价格会来回震荡、做选择的地方)，不是"地板"
//     · 先看趋势 (如 200 日均线)，再看筹码；下降趋势中的筹码区不比别处更可靠
//     · 不要碰到就买：等回踩后收盘重新站上 VAL / 放量上涨日等确认，止损放 VAL 下方
//     · 跌破价值区下沿后下方若是筹码真空，下跌往往加速
// ═══════════════════════════════════════════════════════════════

rows      = input.int(120, "价格行数", minval = 20, maxval = 240)
widthPct  = input.int(30, "宽度 (% 可见区域)", minval = 5, maxval = 100)
vaPct     = input.int(70, "价值区 Value Area %", minval = 10, maxval = 100)
splitUD   = input.bool(true, "区分上涨/下跌成交量")
useFixed  = input.bool(false, "改用固定起始日期 (不随缩放变化)")
fixedFrom = input.time(timestamp("2023-09-01"), "固定起始日期")
colVAUp   = input.color(color.new(#26a69a, 45), "价值区 上涨量", group = "颜色")
colVADn   = input.color(color.new(#26a69a, 65), "价值区 下跌量", group = "颜色")
colUp     = input.color(color.new(#9e9e9e, 55), "价值区外 上涨量", group = "颜色")
colDn     = input.color(color.new(#9e9e9e, 72), "价值区外 下跌量", group = "颜色")
showPOC   = input.bool(true, "显示 POC 线", group = "颜色")
colPOC    = input.color(color.new(#787b86, 0), "POC 颜色", group = "颜色")
showVA    = input.bool(false, "显示 VAH / VAL 线", group = "颜色")

var array<box>   boxes = array.new<box>()
var array<line>  lns   = array.new<line>()
var array<label> lbs   = array.new<label>()

if barstate.islast
    for b in boxes
        box.delete(b)
    array.clear(boxes)
    for l in lns
        line.delete(l)
    array.clear(lns)
    for lb in lbs
        label.delete(lb)
    array.clear(lbs)

    int leftT  = useFixed ? fixedFrom : chart.left_visible_bar_time
    int rightT = useFixed ? time : chart.right_visible_bar_time

    // 找出范围内的K线 (偏移 iStart..iEnd, 0 = 最新)
    int iEnd = 0
    while iEnd < 4999 and iEnd < bar_index and time[iEnd] > rightT
        iEnd += 1
    int iStart = iEnd
    while iStart + 1 <= math.min(4999, bar_index) and time[iStart + 1] >= leftT
        iStart += 1
    // 达到 5,000 根上限且更早的K线仍在范围内 → 被截断
    bool truncated = iStart >= 4999 and bar_index > 4999 and time[4999] > leftT

    float lo = low[iEnd]
    float hi = high[iEnd]
    for i = iEnd to iStart
        lo := math.min(lo, low[i])
        hi := math.max(hi, high[i])
    float step = math.max((hi - lo) / rows, syminfo.mintick)

    // 差分数组：每根K线 O(1) 累加，再做一次前缀和，避免 K线数 × 行数 的内层循环
    array<float> dU = array.new<float>(rows + 1, 0.0)
    array<float> dD = array.new<float>(rows + 1, 0.0)
    for i = iEnd to iStart
        int k0 = math.min(rows - 1, int(math.floor((low[i] - lo) / step)))
        int k1 = math.min(rows - 1, int(math.floor((high[i] - lo) / step)))
        float v = nz(volume[i]) / (k1 - k0 + 1)   // 成交量在 high-low 间均匀分配
        array<float> d = close[i] >= open[i] ? dU : dD
        array.set(d, k0, array.get(d, k0) + v)
        array.set(d, k1 + 1, array.get(d, k1 + 1) - v)

    array<float> upV = array.new<float>(rows, 0.0)
    array<float> dnV = array.new<float>(rows, 0.0)
    array<float> tot = array.new<float>(rows, 0.0)
    float runU = 0.0
    float runD = 0.0
    for k = 0 to rows - 1
        runU += array.get(dU, k)
        runD += array.get(dD, k)
        array.set(upV, k, math.max(runU, 0.0))
        array.set(dnV, k, math.max(runD, 0.0))
        array.set(tot, k, array.get(upV, k) + array.get(dnV, k))
    float allV = array.sum(tot)
    bool hasVol = allV > 0
    float maxV = array.max(tot)
    int poc = array.indexof(tot, maxV)

    // 价值区：从 POC 向两侧扩展，每次加入较大的相邻行
    int a = poc
    int b = poc
    float acc = maxV
    while acc < allV * vaPct / 100.0 and (a > 0 or b < rows - 1)
        float upN = b < rows - 1 ? array.get(tot, b + 1) : -1.0
        float dnN = a > 0 ? array.get(tot, a - 1) : -1.0
        if upN >= dnN
            b += 1
            acc += upN
        else
            a -= 1
            acc += dnN

    int x0 = bar_index - iStart
    int span = math.max(1, iStart - iEnd + 1)
    float maxW = span * widthPct / 100.0
    for k = 0 to rows - 1
        float t = array.get(tot, k)
        if t > 0
            bool inVA = k >= a and k <= b
            float bot = lo + k * step
            float top = bot + step * 0.9
            if splitUD
                int wU = int(math.round(array.get(upV, k) / maxV * maxW))
                int wT = int(math.round(t / maxV * maxW))
                if wU > 0
                    array.push(boxes, box.new(x0, top, x0 + wU, bot, border_width = 0, bgcolor = inVA ? colVAUp : colUp))
                if wT > wU
                    array.push(boxes, box.new(x0 + wU, top, x0 + wT, bot, border_width = 0, bgcolor = inVA ? colVADn : colDn))
            else
                int wT = int(math.round(t / maxV * maxW))
                if wT > 0
                    array.push(boxes, box.new(x0, top, x0 + wT, bot, border_width = 0, bgcolor = inVA ? colVAUp : colUp))

    float pocP = lo + (poc + 0.5) * step
    float vah  = lo + (b + 1) * step
    float val  = lo + a * step
    if not hasVol
        array.push(lbs, label.new(x0, hi, "⚠ 该品种没有成交量数据，无法计算筹码峰", style = label.style_label_lower_left, color = color.new(#f23645, 20), textcolor = color.white, size = size.small))
    else if truncated
        array.push(lbs, label.new(x0, hi, "⚠ 范围超过 5,000 根K线，只统计了最近 5,000 根", style = label.style_label_lower_left, color = color.new(#ff9800, 20), textcolor = color.white, size = size.small))
    if showPOC and hasVol
        array.push(lns, line.new(x0, pocP, bar_index, pocP, color = colPOC, style = line.style_dotted, extend = extend.right))
    if showVA and hasVol
        array.push(lns, line.new(x0, vah, bar_index, vah, color = color.new(#26a69a, 0), style = line.style_dashed, extend = extend.right))
        array.push(lns, line.new(x0, val, bar_index, val, color = color.new(#26a69a, 0), style = line.style_dashed, extend = extend.right))
        array.push(lbs, label.new(bar_index, vah, "VAH " + str.tostring(vah, format.mintick), style = label.style_label_left, color = color.new(color.white, 100), textcolor = #26a69a, size = size.small))
        array.push(lbs, label.new(bar_index, val, "VAL " + str.tostring(val, format.mintick), style = label.style_label_left, color = color.new(color.white, 100), textcolor = #26a69a, size = size.small))
