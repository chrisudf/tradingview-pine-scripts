//@version=5
indicator("Vol Regime Dashboard — VRP + Skew + Tail", overlay=false, precision=2)

// ============ 输入 ============
rvLen        = input.int(20,    "RV 计算窗口 (日)", minval=5)
vrpHi        = input.float(1.30,"VRP 高阈值 (VIX/RV)", step=0.05)
vrpLo        = input.float(1.00,"VRP 低阈值 (VIX/RV)", step=0.05)
skewHi       = input.float(145, "SKEW 紧张阈值",     step=1)
skewLo       = input.float(120, "SKEW 自满阈值",     step=1)
vvixRatioHi  = input.float(5.5, "VVIX/VIX 紧张阈值", step=0.1)
showTable    = input.bool(true, "显示信号表")

// ============ 数据源 ============
spx  = request.security("SPX",  timeframe.period, close)
vix  = request.security("VIX",  timeframe.period, close)
vvix = request.security("VVIX", timeframe.period, close)
skew = request.security("SKEW", timeframe.period, close)

// ============ 计算 ============
// SPX 20日实现波动率（年化，百分数）
logret = math.log(spx / spx[1])
rv     = ta.stdev(logret, rvLen) * math.sqrt(252) * 100

// VRP 代理 = VIX / RV20
vrp    = vix / rv

// VVIX / VIX 比值（尾部风险 of 尾部风险）
vvRatio = vvix / vix

// ============ 绘图 ============
plot(vrp,     "VRP (VIX/RV)", color=color.aqua, linewidth=2)
hline(vrpHi,  "VRP 高", color=color.new(color.green, 40), linestyle=hline.style_dashed)
hline(vrpLo,  "VRP 低", color=color.new(color.red,   40), linestyle=hline.style_dashed)
hline(1.0,    "IV=RV", color=color.gray)

// 背景颜色：卖方甜蜜区 / 危险区
bgcolor(vrp >  vrpHi ? color.new(color.green, 85) : na, title="Sell Vol 区")
bgcolor(vrp <  vrpLo ? color.new(color.red,   85) : na, title="Long Vol 区")

// ============ 信号判断 ============
sellVolOK = vrp > vrpHi and skew < skewHi              // 卖方甜蜜区：VRP 高但尾部没爆表
tailCheap = skew < skewLo and vvRatio < 4.5            // 尾部对冲便宜：SKEW 低 & VVIX/VIX 平静
panic     = vix > 25 and vvRatio > vvixRatioHi         // 恐慌：抄底信号（卖 put）
complacent= vix < 14 and skew < skewLo                 // 自满：买保险
avoidSell = vrp < vrpLo                                 // 不要卖 vol：IV 已经低于 RV

regime = panic       ? "PANIC — 卖 Put 抄底"    :
         sellVolOK   ? "SELL VOL — VRP 甜蜜区"  :
         tailCheap   ? "TAIL CHEAP — 加对冲"    :
         complacent  ? "COMPLACENT — 买保险"    :
         avoidSell   ? "AVOID SELL — IV<RV"     :
                       "NEUTRAL"

regColor = panic       ? color.orange :
           sellVolOK   ? color.green  :
           tailCheap   ? color.blue   :
           complacent  ? color.purple :
           avoidSell   ? color.red    :
                         color.gray

// ============ 信号表 ============
var table t = table.new(position.top_right, 2, 8, border_width=1)
if showTable and barstate.islast
    table.cell(t, 0, 0, "指标",        bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(t, 1, 0, "数值",        bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(t, 0, 1, "VIX")
    table.cell(t, 1, 1, str.tostring(vix, "#.##"))
    table.cell(t, 0, 2, "RV" + str.tostring(rvLen))
    table.cell(t, 1, 2, str.tostring(rv, "#.##"))
    table.cell(t, 0, 3, "VRP (VIX/RV)")
    table.cell(t, 1, 3, str.tostring(vrp, "#.##"),
               bgcolor = vrp > vrpHi ? color.new(color.green, 60) :
                         vrp < vrpLo ? color.new(color.red,   60) : na)
    table.cell(t, 0, 4, "SKEW")
    table.cell(t, 1, 4, str.tostring(skew, "#.#"),
               bgcolor = skew > skewHi ? color.new(color.red, 60) :
                         skew < skewLo ? color.new(color.green, 60) : na)
    table.cell(t, 0, 5, "VVIX/VIX")
    table.cell(t, 1, 5, str.tostring(vvRatio, "#.##"),
               bgcolor = vvRatio > vvixRatioHi ? color.new(color.red, 60) : na)
    table.cell(t, 0, 6, "VVIX")
    table.cell(t, 1, 6, str.tostring(vvix, "#.#"))
    table.cell(t, 0, 7, "REGIME", bgcolor=color.new(color.black, 0), text_color=color.white)
    table.cell(t, 1, 7, regime,   bgcolor=regColor, text_color=color.white)

// ============ 提醒 ============
alertcondition(ta.crossover(vrp, vrpHi),  "进入卖方甜蜜区", "VRP 突破高阈值")
alertcondition(ta.crossunder(vrp, vrpLo), "进入 IV<RV 区", "别卖 Vol")
alertcondition(panic,                     "PANIC 恐慌信号", "考虑卖 Put 抄底")
alertcondition(complacent,                "COMPLACENT 自满", "尾部保护便宜")
