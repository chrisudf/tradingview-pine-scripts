//@version=6
indicator("KDJ (moomoo 口径)", shorttitle = "KDJ", overlay = false, precision = 3)

// 与 moomoo / 通达信 默认 KDJ(9,3,3) 同一公式：
//   RSV = (C − LLV(L,N)) / (HHV(H,N) − LLV(L,N)) × 100
//   K   = SMA(RSV, M1, 1) = (RSV + (M1−1)·K[1]) / M1     初值 50
//   D   = SMA(K,   M2, 1) = (K   + (M2−1)·D[1]) / M2     初值 50
//   J   = 3K − 2D
n  = input.int(9, "RSV 周期 N", minval = 1)
m1 = input.int(3, "K 平滑 M1", minval = 1)
m2 = input.int(3, "D 平滑 M2", minval = 1)

hh = ta.highest(high, n)
ll = ta.lowest(low, n)

var float rsv = 50.0
var float k   = 50.0
var float d   = 50.0

if not na(hh) and not na(ll)
    rsv := hh > ll ? (close - ll) / (hh - ll) * 100 : rsv
    k   := (rsv + (m1 - 1) * k) / m1
    d   := (k + (m2 - 1) * d) / m2

j = 3 * k - 2 * d

hline(100, "100", color = color.new(color.gray, 50), linestyle = hline.style_dashed)
hline(80,  "80",  color = color.new(color.gray, 30), linestyle = hline.style_dashed)
hline(50,  "50",  color = color.new(color.gray, 50), linestyle = hline.style_dashed)
hline(20,  "20",  color = color.new(color.gray, 30), linestyle = hline.style_dashed)
hline(0,   "0",   color = color.new(color.gray, 50), linestyle = hline.style_dashed)

plot(k, "K", color = #FF9800, linewidth = 1)
plot(d, "D", color = #29B6F6, linewidth = 1)
plot(j, "J", color = #E040FB, linewidth = 1)
